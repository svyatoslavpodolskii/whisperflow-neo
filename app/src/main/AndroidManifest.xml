<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- Microphone for audio recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Network access to communicate with Whisper GPU server -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Haptic feedback for record start/stop -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wake lock for reliable recording/upload -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground service for long recordings -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required for the digital assistant overlay (long-press power / volume PTT) to draw on top of other apps on Samsung and some OEMs -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Programmatic IME switching for voice keyboard (granted via ADB once) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- Restore previous app to foreground after side key trigger activity -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WhisperFlow"
        android:usesCleartextTraffic="true"
    >

        <!-- Main Activity -->
        <activity
            android:name="com.pimax.whisperflow.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WhisperFlow"
        >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts"
            />
        </activity>

        <!-- App action: Samsung Side key / Routines / shortcuts -->
        <activity
            android:name="com.pimax.whisperflow.VoiceKeyboardTriggerActivity"
            android:exported="true"
            android:label="@string/voice_keyboard_action_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="standard"
        >
            <intent-filter>
                <action
                    android:name="com.pimax.whisperflow.ACTION_VOICE_KEYBOARD"
                />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="com.pimax.whisperflow.VoiceKeyboardTriggerService"
            android:exported="true"
            android:label="@string/voice_keyboard_action_label"
        >
            <intent-filter>
                <action
                    android:name="com.pimax.whisperflow.ACTION_VOICE_KEYBOARD"
                />
            </intent-filter>
        </service>

        <receiver
            android:name="com.pimax.whisperflow.VoiceKeyboardReceiver"
            android:exported="true"
            android:label="@string/voice_keyboard_action_label"
        >
            <intent-filter>
                <action
                    android:name="com.pimax.whisperflow.ACTION_VOICE_KEYBOARD"
                />
            </intent-filter>
        </receiver>

        <!-- WhisperFlow IME — voice input keyboard -->
        <service
            android:name="com.pimax.whisperflow.WhisperInputService"
            android:exported="true"
            android:label="WhisperFlow Voice"
            android:permission="android.permission.BIND_INPUT_METHOD"
        >
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method"
            />
        </service>

        <!-- WhisperFlow Voice Assistant — long-press power button -->
        <service
            android:name="com.pimax.whisperflow.WhisperAssistService"
            android:exported="true"
            android:label="WhisperFlow Voice"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
        >
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assist_service"
            />
            <intent-filter>
                <action
                    android:name="android.service.voice.VoiceInteractionService"
                />
            </intent-filter>
        </service>

        <service
            android:name="com.pimax.whisperflow.WhisperAssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
        >
            <intent-filter>
                <action
                    android:name="android.service.voice.VoiceInteractionSessionService"
                />
            </intent-filter>
        </service>

        <!-- Hardware Button PTT Listener -->
        <service
            android:name="com.pimax.whisperflow.WhisperAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
        >
            <intent-filter>
                <action
                    android:name="android.accessibilityservice.AccessibilityService"
                />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"
            />
        </service>

        <!-- Watch Relay — receives audio from Galaxy Watch via Wearable Data Layer -->
        <service
            android:name="com.pimax.whisperflow.WatchRelayService"
            android:exported="true"
        >
            <intent-filter>
                <action
                    android:name="com.google.android.gms.wearable.DATA_CHANGED"
                />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/whisper" />
            </intent-filter>
            <intent-filter>
                <action
                    android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"
                />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/whisper" />
            </intent-filter>
        </service>

        <service android:name=".VoiceMemoryReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/voice-memory/v1/audio/" />
            </intent-filter>
        </service>
        <service android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync" tools:node="merge" />

        <!-- Declare capability so the watch can discover this phone node -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version"
        />

        <!-- Wearable capabilities (for watch discovery) -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false"
        />
        <meta-data
            android:name="com.google.android.gms.wearable.CAPABILITY"
            android:resource="@xml/wear"
        />

    </application>

</manifest>

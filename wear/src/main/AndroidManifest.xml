<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declare this is a Wear OS app -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Microphone for recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Keep CPU alive during recording -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Network access for direct GPU server mode -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault"
    >

        <!-- Main watch activity -->
        <activity
            android:name=".WearMainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault"
        >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Metadata declaring this is a standalone Wear OS app (does not require phone app) -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false"
        />

        <!-- Receive messages/data from phone -->
        <service
            android:name=".WatchMessageReceiver"
            android:exported="true"
            android:permission="com.google.android.gms.permission.BIND_NETWORK_TASK_SERVICE"
        >
            <intent-filter>
                <action
                    android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"
                />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/whisper"
                />
            </intent-filter>
        </service>

    </application>

</manifest>
